# Copiez ce fichier en .env pour le développement local.
# En production (Render), ces variables sont fournies via le dashboard / render.yaml.

# Clé secrète Django (obligatoire en prod, générez-en une longue et aléatoire)
DJANGO_SECRET_KEY=dev-insecure-key-change-me

# true en local, false en production
DJANGO_DEBUG=true

# Hôtes autorisés, séparés par des virgules (Render ajoute son hôte automatiquement)
DJANGO_ALLOWED_HOSTS=*

# Origines de confiance CSRF (https://votre-app.onrender.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de données : laissez vide pour SQLite local, ou indiquez une URL Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Mettre true si la base Postgres exige SSL (cas de Render)
DJANGO_DB_SSL=false

# Forcer HTTPS en prod
DJANGO_SECURE_SSL_REDIRECT=false

DJANGO_TIME_ZONE=UTC
